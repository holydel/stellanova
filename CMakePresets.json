{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Dev;Retail",
				"CMAKE_DEFAULT_BUILD_TYPE": "Dev",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "windows-base",
			"hidden": true,
			"inherits": "base",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"architecture": { "value": "x64", "strategy": "external" },
			"toolset": { "value": "host=x64", "strategy": "external" }
		},
		{
			"name": "windows-msvc",
			"displayName": "Windows x64 (MSVC)",
			"inherits": "windows-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "windows-clang",
			"displayName": "Windows x64 (clang-cl)",
			"inherits": "windows-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "$env{VSINSTALLDIR}VC/Tools/Llvm/x64/bin/clang-cl.exe",
				"CMAKE_CXX_COMPILER": "$env{VSINSTALLDIR}VC/Tools/Llvm/x64/bin/clang-cl.exe"
			}
		},
		{
			"name": "web",
			"displayName": "Web (Emscripten; tests run in Node)",
			"inherits": "base",
			"toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
		},
		{
			"name": "linux-x64",
			"displayName": "Linux x64 (Steam Runtime 4, cross-compiled with clang; tests run over SSH)",
			"inherits": "base",
			"toolchainFile": "${sourceDir}/../pith/cmake/steamrt4.toolchain.cmake",
			"cacheVariables": {
				"PH_STEAMRT_ARCH": "amd64"
			}
		},
		{
			"name": "windows-vs",
			"displayName": "Visual Studio 2026 solution",
			"generator": "Visual Studio 18 2026",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Dev;Retail"
			}
		}
	]
}
